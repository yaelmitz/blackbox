# Copy to .env and fill in.

# sqlite (default, nothing to install) or postgres
DB_TYPE=sqlite

# PostgreSQL connection (or set DATABASE_URL=postgres://user:pass@host:5432/db instead)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=blackbox

# Create/update tables from the entities on start (dev only)
DB_SYNC=true
# Fill an empty database with the example investigations
SEED=true

# the frontend (Vite) proxies /api to this port
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
